<?xml version="1.0" encoding="utf-8"?>
<!-- Port of TvButton / TvChip / TvIconButton (Controls.kt): white with black content when focused, scale 1.05. -->
<component name="TvButton" extends="Group">
  <interface>
    <field id="text" type="string" onChange="layout" />
    <field id="icon" type="string" onChange="layout" />
    <!-- "button" | "chip" | "icon" -->
    <field id="variant" type="string" value="button" onChange="layout" />
    <field id="primary" type="boolean" value="false" onChange="restyle" />
    <!-- chips: selected (accent + check); icon buttons: active -->
    <field id="checked" type="boolean" value="false" onChange="layout" />
    <!-- icon buttons: diameter -->
    <field id="iconSize" type="integer" value="61" onChange="layout" />
    <field id="minWidth" type="integer" value="0" onChange="layout" />
    <field id="fontSize" type="integer" value="20" onChange="layout" />
    <field id="dim" type="boolean" value="false" onChange="restyle" />
    <field id="data" type="assocarray" />
    <field id="width" type="float" />
    <field id="height" type="float" />
    <field id="pressed" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/lib/Utils.brs" />
  <script type="text/brightscript" uri="TvButton.brs" />
  <children>
    <Group id="body">
      <Poster id="bg" uri="pkg:/images/rr8.9.png" />
      <Poster id="iconPoster" width="26" height="26" />
      <Label id="label" vertAlign="center">
        <Font role="font" uri="font:BoldSystemFontFile" size="20" />
      </Label>
    </Group>
  </children>
</component>
