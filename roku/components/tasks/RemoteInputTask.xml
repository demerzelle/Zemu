<?xml version="1.0" encoding="utf-8"?>
<!-- Port of RemoteInputServer.kt: a tiny web page on the TV so a phone can paste addon URLs. -->
<component name="RemoteInputTask" extends="Task">
  <interface>
    <field id="port" type="integer" value="8765" />
    <field id="address" type="string" />
    <field id="received" type="string" alwaysNotify="true" />
    <field id="reply" type="string" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/lib/Utils.brs" />
  <script type="text/brightscript" uri="RemoteInputTask.brs" />
</component>
